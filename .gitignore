rag/.chroma/
**/.chroma/

# --- Datasets (large, downloaded separately — see README) ---
data/*.csv
data/*.txt
!data/.gitkeep

# --- Streamlit ---
.streamlit/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Logs ---
*.log
nohup.out

# --- Leftover shell artifacts (e.g. brace-expansion mistakes on Windows) ---
{*}*