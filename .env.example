# All settings are optional. The project needs no API keys: every model runs
# locally and nothing calls an external service.

# Plant clock speed: 1 = real time, 10 = ten times faster.
# TWIN_SPEED=1

# Force the models to retrain on the next start (otherwise they are cached
# in .model_cache/ and retrained only when training code changes).
# TWIN_RETRAIN=1

# Where the trained-model cache lives.
# TWIN_MODEL_CACHE=.model_cache

# Training data for the models: twin (default), cmapss, or ai4i2020.
# DATA_SOURCE=twin

# Backend URL for the optional Streamlit dashboard (dashboard/app.py).
# API_BASE_URL=http://localhost:8000
